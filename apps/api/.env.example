# Local PostgreSQL (installed natively - see README, no Docker required).
# Superuser connection - used only by `npm run db:setup` to create roles/policies/tables.
DATABASE_URL=postgres://campusos:campusos_dev@localhost:5432/campusos
# App runtime connection - a non-owner role, required so FORCE ROW LEVEL SECURITY
# actually applies (Section 10.2 of the requirements doc). Never point the running
# API at the superuser connection above.
APP_DATABASE_URL=postgres://campusos_app:campusos_app_dev@localhost:5432/campusos

PORT=3001

# --- Not wired up yet ---
# These are for features not yet built (caching, async jobs/notifications, auth
# SSO, file storage). When you connect AWS or Azure, point these at the managed
# equivalent instead of running anything extra locally:
#   Redis      -> AWS ElastiCache / Azure Cache for Redis
#   RabbitMQ   -> Amazon MQ / Azure Service Bus
#   S3/MinIO   -> AWS S3 / Azure Blob Storage
#   Keycloak   -> self-hosted on a small VM, or AWS Cognito / Azure Entra ID
# REDIS_URL=
# RABBITMQ_URL=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# KEYCLOAK_URL=
